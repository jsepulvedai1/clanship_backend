# Configuración General de Django
DJANGO_SECRET_KEY=generar-un-secret-key-muy-seguro-aqui
DJANGO_DEBUG=False
ALLOWED_HOSTS=api.clanship.cl,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.clanship.cl

# Configuración de Base de Datos PostgreSQL (Droplet DB)
# NOTA: Usar la IP Privada del Droplet DB si ambos están en la misma VPC/región.
DB_HOST=10.x.x.x
DB_PORT=5432
DB_NAME=clanship_db
DB_USER=clanship_user
DB_PASSWORD=contrasena-super-segura-del-usuario

# Cambiar a True si la base de datos externa requiere SSL obligatorio
DATABASE_SSL_REQUIRE=False

# Opcional: Si prefieres pasar la URI completa de la base de datos (por ejemplo, con Managed Databases)
# DATABASE_URL=postgres://clanship_user:contrasena@10.x.x.x:5432/clanship_db?sslmode=disable

# Configuración del Superusuario Administrador Inicial (Creado en el primer despliegue)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@clanship.cl
DJANGO_SUPERUSER_PASSWORD=contrasena-segura-admin

# ─── Configuración de Email SMTP ───────────────────────────────────────────────
# Gmail: usar una "Contraseña de aplicación" (2FA debe estar activado)
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
DEFAULT_FROM_EMAIL=Equipo Clanship <tu-correo@gmail.com>


# SendGrid API Key (PRODUCCIÓN — tiene prioridad sobre SMTP)
# Crea una cuenta gratis en https://sendgrid.com (100 emails/día gratis)
# Luego ve a Settings > API Keys > Create API Key (Full Access)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
